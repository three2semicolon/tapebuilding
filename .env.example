# spotify - https://developer.spotify.com/dashboard

# either use
# spotify api client credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# or 
# spotify sp_dc cookie, obtained from your browser after logging into Spotify
SPOTIFY_SP_DC=

# profile
SPOTIFY_USER_ID=

# paths
ARCHIVE_PATH=        # full library archive, e.g. /Volumes/music/archive
TAPEDECK_PATH=       # tapedeck e.g. Y:/music/tapedeck
PLAYLISTS_PATH=      # .m3u playlist files, e.g. Y:/music/playlists

# download
DOWNLOAD_FORMAT=mp3
DOWNLOAD_QUALITY=320k

# ffmpeg
FFMPEG_PATH=

# download defaults
DOWNLOAD_PRE_SKIP_EXISTING=true
DOWNLOAD_COOKIES_FILE=path/to/cookies.txt
DOWNLOAD_RETRIES=0

# config
CONFIG_PATH=               # Path to config.yaml (defaults to project root/config.yaml)

# soundbyte - album management
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=   # Path to service account JSON
